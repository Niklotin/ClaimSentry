# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=aika_claims
POSTGRES_PORT=5432

# .NET 9 Aika Engine Configuration
AIKA_ENGINE_PORT=5000
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__DefaultConnection=Host=postgres;Port=5432;Database=aika_claims;Username=postgres;Password=postgres

# n8n Configuration
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/Helsinki
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# LLM Providers (for n8n AI Agent and DeepEval)
OPENAI_API_KEY=your_openai_api_key_here
